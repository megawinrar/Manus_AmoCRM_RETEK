# amoCRM Integration — RETEK Archiver
# Скопируйте этот файл в .env и заполните реальными значениями

# Домен аккаунта amoCRM (без https://)
AMO_DOMAIN=tokutools.amocrm.ru

# Внешняя интеграция — ключи из amoМаркет → Установленные → RETEK Archiver
AMO_CLIENT_ID=13b2e6f9-5634-4dd0-82e3-409a438d075a
AMO_CLIENT_SECRET=YOUR_SECRET_KEY_HERE

# OAuth токены (заполняются автоматически скриптом auth.py)
AMO_ACCESS_TOKEN=
AMO_REFRESH_TOKEN=
AMO_TOKEN_EXPIRES_AT=

# ID воронок (заполняются после создания воронок)
AMO_PIPELINE_ACTIVE_ID=
AMO_PIPELINE_ARCHIVE_DIRECTIONS_ID=
AMO_PIPELINE_ARCHIVE_SOZ_ID=
