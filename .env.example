# ═══════════════════════════════════════════════════════════════════
# RETEK amoCRM Microservice — Configuration
# ═══════════════════════════════════════════════════════════════════
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# ─── amoCRM подключение ──────────────────────────────────────────
AMO_DOMAIN=tokutools.amocrm.ru
AMO_CLIENT_ID=13b2e6f9-5634-4dd0-82e3-409a438d075a
AMO_CLIENT_SECRET=YOUR_SECRET_KEY_HERE
AMO_ACCESS_TOKEN=YOUR_JWT_TOKEN_HERE
AMO_REFRESH_TOKEN=
AMO_TOKEN_EXPIRES_AT=

# ─── Воронки (Pipeline IDs) ─────────────────────────────────────
AMO_PIPELINE_ACTIVE_ID=10984442
AMO_PIPELINE_ARCHIVE_DIRECTIONS_ID=10984454
AMO_PIPELINE_ARCHIVE_SOZ_ID=10985038

# ─── Статусы активной воронки (11 статусов) ──────────────────────
# Получить через: GET /api/v4/leads/pipelines/10984442/statuses
STATUS_1_LLM=
STATUS_2_CHECK=
STATUS_3_SOZ_CALL=
STATUS_4_SOZ_WAIT=
STATUS_5_PURCHASING=
STATUS_6_KP_PREP=
STATUS_7_KP_DEALER=
STATUS_8_DEALER_DEC=
STATUS_9_BIDDING=
STATUS_10_PRODUCTION=
STATUS_11_ARCHIVE=

# Системные статусы
STATUS_SUCCESS=142
STATUS_CLOSED=143
STATUS_UNSORTED=86352246

# ─── Статусы архива — Направления ────────────────────────────────
# Получить через: GET /api/v4/leads/pipelines/10984454/statuses
ARCH_DIR_SPEC=
ARCH_DIR_HSS=
ARCH_DIR_CARBIDE=
ARCH_DIR_DIAMOND=
ARCH_DIR_OUT=
ARCH_DIR_DUPL=
ARCH_DIR_CHECK=

# ─── Статусы архива — СОЗ / развитие ────────────────────────────
# Получить через: GET /api/v4/leads/pipelines/10985038/statuses
ARCH_SOZ_WAIT=
ARCH_SOZ_CALL=
ARCH_SOZ_30D=
ARCH_SOZ_90D=
ARCH_SOZ_FACTORY=
ARCH_SOZ_IRRELEVANT=

# ─── Пользователи (User IDs) ────────────────────────────────────
# Получить через: GET /api/v4/users
USER_EMPLOYEE_2=
USER_EMPLOYEE_3=
USER_MANAGER=

# ─── Кастомные поля (Field IDs) ─────────────────────────────────
# По умолчанию используются IDs из create_custom_fields.py (380291–380353)
# Переопределить если отличаются:
# FIELD_EXTERNAL_ID=380291
# FIELD_SOURCE=380293
# FIELD_PLATFORM_URL=380295
# ... и т.д.

# ─── Яндекс.Диск (OAuth) ────────────────────────────────────────
# Получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_CLIENT_ID
YADISK_TOKEN=
YADISK_CLIENT_ID=
YADISK_CLIENT_SECRET=
YADISK_ROOT_FOLDER=/ТОРГИ

# ─── Яндекс GPT (AI Studio) ────────────────────────────────────
# Получить: https://aistudio.yandex.ru → Create API key
# Требуется активный биллинг в Yandex Cloud
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest

# ─── Сервер ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Режим работы ────────────────────────────────────────────────
# DRY_RUN=1 — никакие действия НЕ применяются к amoCRM (для тестирования)
# DRY_RUN=0 — рабочий режим
DRY_RUN=1

# LLM_MODE=training — LLM работает, результаты логируются, НЕ применяются
# LLM_MODE=production — LLM работает и результаты применяются автоматически
LLM_MODE=training
